# Diaa Store — Environment Variables
# Copy this file to .env and fill in your values

# ── Supabase ──────────────────────────────
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Telegram Bot ──────────────────────────
VITE_TELEGRAM_BOT_TOKEN=your_bot_token
VITE_TELEGRAM_CHAT_ID=your_default_chat_id

# ── Telegram Group Channels ───────────────
# Required — the app will NOT fall back to hardcoded IDs
VITE_TELEGRAM_NOTICE_ID=your_notice_group_id
VITE_TELEGRAM_STOCK_ID=your_stock_group_id
VITE_TELEGRAM_SALES_ID=your_sales_group_id
VITE_TELEGRAM_REPORT_ID=your_report_group_id
